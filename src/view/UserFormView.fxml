<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
  View (the "V" in MVC) - designed to be edited in Scene Builder.
  The fx:controller attribute binds this layout to the Controller, and the
  fx:id / onAction hooks connect the widgets to the controller's fields
  and methods.
-->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.UserFormController"
      spacing="16.0" styleClass="root-pane">
    <padding>
        <Insets top="24.0" right="28.0" bottom="24.0" left="28.0"/>
    </padding>

    <children>
        <Label text="User Registration" styleClass="title"/>
        <Label text="Enter your details and press Submit." styleClass="subtitle"/>

        <GridPane hgap="12.0" vgap="6.0">
            <columnConstraints>
                <ColumnConstraints minWidth="90.0" halignment="RIGHT"/>
                <ColumnConstraints minWidth="260.0" hgrow="ALWAYS"/>
            </columnConstraints>

            <children>
                <!-- Name -->
                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" promptText="e.g. Mohammed Mansuri"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label fx:id="nameError" styleClass="error"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Age -->
                <Label text="Age:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="ageField" promptText="e.g. 25"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label fx:id="ageError" styleClass="error"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Email -->
                <Label text="Email:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField" promptText="e.g. you@example.com"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label fx:id="emailError" styleClass="error"
                       GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </children>
        </GridPane>

        <HBox spacing="12.0" alignment="CENTER_RIGHT">
            <children>
                <Button text="Clear" onAction="#handleClear" styleClass="secondary"/>
                <Button text="Submit" onAction="#handleSubmit" defaultButton="true"
                        styleClass="primary"/>
            </children>
        </HBox>
    </children>
</VBox>
